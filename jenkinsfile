pipeline {
    agent any
    environment { 
        CC = 'clang'
    }
    stages {
        stage('Exemple') {
            environment { 
                DEBUG_FLAGS = '-g'
            }
            steps {
                echo "Exécution du build ${env.BUILD_ID} sur ${env.JENKINS_URL}"
                sh 'printenv'
            }
        }
        stage('Build') {
            steps {
                echo 'Building...'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing..'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying....'
            }
        }
    }
}

